{
  "name": "family-school",
  "version": "1.0.0",
  "description": "Family School Desktop App",
  "main": "src/main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder --win --x64"
  },
  "build": {
    "appId": "com.familyschool.app",
    "productName": "Family School",
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": "nsis",
      "icon": "assets/logo.png"
    },
    "nsis": {
      "oneClick": true,
      "installerIcon": "assets/logo.png",
      "uninstallerIcon": "assets/logo.png",
      "installerHeaderIcon": "assets/logo.png",
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    }
  },
  "devDependencies": {
    "electron": "^28.0.0",
    "electron-builder": "^24.0.0"
  }
}
